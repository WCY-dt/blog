---
---
[
{%- assign first_post = true -%}
{%- for post in site.posts -%}
  {%- if post.draft and jekyll.environment == 'production' -%}{%- continue -%}{%- endif -%}
  {%- unless first_post -%},{%- endunless -%}
  {%- assign first_post = false -%}
  {"title":{{ post.title | jsonify }},"summary":{{ post.summary | default: '' | strip_html | strip_newlines | jsonify }},"category":{{ post.categories | join: ',' | jsonify }},"tags":{{ post.tags | join: ',' | jsonify }},"url":{{ post.url | relative_url | jsonify }},"content":{{ post.content | strip_html | strip_newlines | jsonify }}}
{%- endfor -%}
]
